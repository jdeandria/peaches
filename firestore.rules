rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(peachId) { return signedIn() && request.auth.uid == peachId; }
    function isMember(crateId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/crates/$(crateId)/memberships/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/crates/$(crateId)/memberships/$(request.auth.uid)).data.status == 'active';
    }
    function canManage(crateId) {
      let m = get(/databases/$(database)/documents/crates/$(crateId)/memberships/$(request.auth.uid)).data;
      return isMember(crateId) && (m.role == 'owner' || m.role == 'admin');
    }
    function seasonCrate(seasonId) {
      return get(/databases/$(database)/documents/seasons/$(seasonId)).data.crateId;
    }

    // Profiles are public to signed-in users (names appear in standings);
    // only the owner writes.
    match /peaches/{peachId} {
      allow read: if signedIn();
      allow create, update: if isSelf(peachId) && request.resource.data.id == peachId;
      allow delete: if false;
    }

    match /crates/{crateId} {
      // Lookup by invite code needs a read before membership exists.
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerPeachId == request.auth.uid;
      allow update: if canManage(crateId) && request.resource.data.ownerPeachId == resource.data.ownerPeachId;
      allow delete: if false;

      match /memberships/{peachId} {
        // Read through the collection-group rule below. Join yourself as a plain member, or manage others as owner/admin.
        allow create: if isSelf(peachId) && request.resource.data.role == 'member'
                      || canManage(crateId);
        allow update: if isSelf(peachId) && request.resource.data.role == resource.data.role
                      || canManage(crateId);
        allow delete: if false;
      }

      // Copies of submitted logs, written by their Peach in the same batch
      // as the log itself, and again whenever they edit it. Members read
      // them to score matchups. A session's plan never leaves its Peach.
      match /logs/{logId} {
        allow read: if isMember(crateId);
        allow create, update: if isSelf(request.resource.data.peachId)
                              && (resource == null || resource.data.peachId == request.auth.uid)
                              && isMember(crateId)
                              && request.resource.data.id == logId
                              && request.resource.data.status == 'submitted'
                              && crateId in request.resource.data.sharedWith
                              && request.resource.data.get('plan', []).size() == 0;
        allow delete: if false;
      }

      // The exercises each member has logged, shared in the same batch as
      // their logs: one per exercise per member, keyed "<exerciseId>__<peachId>".
      match /exercises/{key} {
        allow read: if isMember(crateId);
        allow create, update: if isSelf(request.resource.data.peachId)
                              && isMember(crateId)
                              && request.resource.data.crateId == crateId
                              && key == request.resource.data.exerciseId + '__' + request.auth.uid;
        allow delete: if false;
      }

      // One ballot per member, keyed by Peach id; only its owner writes it.
      match /ballots/{peachId} {
        allow read: if isMember(crateId);
        allow create, update: if isSelf(peachId)
                              && isMember(crateId)
                              && request.resource.data.peachId == peachId
                              && request.resource.data.crateId == crateId;
        allow delete: if false;
      }

      // A member questions a crate-mate's numbers, voting to strike them;
      // after that each member (but the workout's owner) only sets their
      // own vote.
      match /disputes/{disputeId} {
        allow read: if isMember(crateId);
        allow create: if isMember(crateId)
                      && request.resource.data.id == disputeId
                      && request.resource.data.crateId == crateId
                      && request.resource.data.openedBy == request.auth.uid
                      && request.resource.data.peachId != request.auth.uid
                      && request.resource.data.votes == { (request.auth.uid): 'strike' };
        allow update: if isMember(crateId)
                      && request.auth.uid != resource.data.peachId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
                      && request.resource.data.votes.diff(resource.data.votes).affectedKeys()
                           .hasOnly([request.auth.uid])
                      && request.resource.data.votes[request.auth.uid] in ['strike', 'keep'];
        allow delete: if false;
      }
    }

    // There is no server: whichever member's device notices that a week has
    // started opens its round, and once its grace period ends closes it
    // (scoring the logs shared with the Crate). So schedules are created by
    // owners/admins, but any active member may advance round, matchup and
    // season state. Rules and participants are frozen at scheduling.
    match /seasons/{seasonId} {
      allow read: if signedIn() && isMember(resource.data.crateId);
      allow create: if signedIn() && canManage(request.resource.data.crateId);
      allow update: if isMember(resource.data.crateId)
                    && request.resource.data.crateId == resource.data.crateId
                    && request.resource.data.participantIds == resource.data.participantIds
                    && request.resource.data.rules == resource.data.rules;
      allow delete: if false;

      match /rounds/{roundId} {
        allow create: if canManage(seasonCrate(seasonId));
        allow update: if isMember(seasonCrate(seasonId))
                      && request.resource.data.weekStart == resource.data.weekStart
                      && request.resource.data.index == resource.data.index;
        allow delete: if false;
      }
      match /matchups/{matchupId} {
        allow create: if canManage(seasonCrate(seasonId));
        allow update: if isMember(seasonCrate(seasonId))
                      && request.resource.data.homePeachId == resource.data.homePeachId
                      && request.resource.data.awayPeachId == resource.data.awayPeachId;
        allow delete: if false;
      }

      // A Peach's lineup for a week, keyed "<roundId>_<peachId>". Secret from
      // crate-mates until it locks when the week starts (`locksAt`, epoch
      // ms), and only changeable before then. A new lineup can lock at most
      // a week (and a day of clock skew) ahead.
      match /lineups/{lineupId} {
        allow get: if resource == null && isMember(seasonCrate(seasonId))
                   || isSelf(resource.data.peachId)
                   || isMember(seasonCrate(seasonId))
                      && request.time.toMillis() >= resource.data.locksAt;
        allow list: if isSelf(resource.data.peachId);
        allow create: if isSelf(request.resource.data.peachId)
                      && isMember(seasonCrate(seasonId))
                      && request.resource.data.seasonId == seasonId
                      && lineupId == request.resource.data.roundId + '_' + request.auth.uid
                      && request.time.toMillis() < request.resource.data.locksAt
                      && request.resource.data.locksAt < request.time.toMillis() + 8 * 86400000;
        allow update: if isSelf(resource.data.peachId)
                      && isMember(seasonCrate(seasonId))
                      && request.resource.data.peachId == resource.data.peachId
                      && request.resource.data.roundId == resource.data.roundId
                      && request.resource.data.locksAt == resource.data.locksAt
                      && request.time.toMillis() < resource.data.locksAt;
        allow delete: if false;
      }
    }

    // The app finds a Peach's memberships across Crates, and rounds and
    // matchups across Seasons, with collection-group queries, which only
    // `{path=**}` rules can allow; such rules can't tell which Crate a
    // document is under. So memberships, rounds and matchups are readable by
    // any signed-in Peach: who belongs where, who plays whom and the scores.
    match /{path=**}/memberships/{peachId} {
      allow read: if signedIn();
    }
    match /{path=**}/rounds/{roundId} {
      allow read: if signedIn();
    }
    match /{path=**}/matchups/{matchupId} {
      allow read: if signedIn();
    }

    // A Peach's own logs, drafts included, are private: Crates see the
    // copies shared with them on submit. Only their Peach edits them.
    match /workoutLogs/{logId} {
      allow read: if isSelf(resource.data.peachId);
      allow create: if isSelf(request.resource.data.peachId);
      allow update: if isSelf(resource.data.peachId)
                    && request.resource.data.peachId == resource.data.peachId;
      allow delete: if false;
    }

    // A Peach's saved routines are theirs alone, to change or delete.
    match /routines/{routineId} {
      allow read, delete: if isSelf(resource.data.peachId);
      allow create: if isSelf(request.resource.data.peachId)
                    && request.resource.data.id == routineId;
      allow update: if isSelf(resource.data.peachId)
                    && request.resource.data.peachId == resource.data.peachId
                    && request.resource.data.id == routineId;
    }
  }
}
