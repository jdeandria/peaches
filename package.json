{
  "name": "peaches",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:emulator": "ng serve --configuration emulator",
    "build": "ng build",
    "build:firebase": "ng build --configuration production,firebase",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage",
    "test:firestore": "firebase emulators:exec --only firestore --project demo-peaches \"vitest run --config vitest.firestore.config.mts\"",
    "e2e": "playwright test",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "theme": "node scripts/generate-theme.mjs",
    "icons": "node scripts/icons.mjs && python3 scripts/subset-icons.py",
    "icons:check": "node scripts/icons.mjs --check",
    "firebase:config": "node scripts/firebase-config.mjs",
    "deploy": "ng build --configuration production,firebase && firebase deploy --only hosting,firestore"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.3",
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "firebase": "^13.0.0",
    "material-symbols": "^0.48.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@material/material-color-utilities": "^0.4.0",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.12.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
